<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Defs_DataCenterOps"
                  targetNamespace="https://etzhayyim.com/bpmn/data-center-ops">
  <bpmn:process id="Process_DataCenterOps_Operations" name="Data Center Operations Management" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Schedule Tick">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CollectTelemetry" name="Collect Facility Telemetry">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_ResolveReverseTopo" name="Resolve Reverse Dependency Topology (Lexicon: com.etzhayyim.apps.dataCenterOps.dependency.getReverseTopo)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_2b</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_EvaluateCapacity" name="Evaluate Rack Capacity">
      <bpmn:incoming>Flow_2b</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CheckSla" name="Check SLA Compliance">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Risk" name="Risk Detected?" default="Flow_6">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CreateIncident" name="Create Incident \u0026 Escalate">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_UpdateDashboard" name="Update Ops Dashboard">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_1" name="Cycle Complete">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CollectTelemetry" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CollectTelemetry" targetRef="Task_ResolveReverseTopo" />
    <bpmn:sequenceFlow id="Flow_2b" sourceRef="Task_ResolveReverseTopo" targetRef="Task_EvaluateCapacity" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_EvaluateCapacity" targetRef="Task_CheckSla" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_CheckSla" targetRef="Gateway_Risk" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_Risk" targetRef="Task_CreateIncident" name="Yes" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_Risk" targetRef="Task_UpdateDashboard" name="No" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CreateIncident" targetRef="Task_UpdateDashboard" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_UpdateDashboard" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_DataCenterOps">
    <bpmndi:BPMNPlane id="BPMNPlane_DataCenterOps" bpmnElement="Process_DataCenterOps_Operations">
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="120" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CollectTelemetry" bpmnElement="Task_CollectTelemetry">
        <dc:Bounds x="210" y="138" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ResolveReverseTopo" bpmnElement="Task_ResolveReverseTopo">
        <dc:Bounds x="390" y="138" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_EvaluateCapacity" bpmnElement="Task_EvaluateCapacity">
        <dc:Bounds x="640" y="138" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CheckSla" bpmnElement="Task_CheckSla">
        <dc:Bounds x="840" y="138" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Risk" bpmnElement="Gateway_Risk" isMarkerVisible="true">
        <dc:Bounds x="1040" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CreateIncident" bpmnElement="Task_CreateIncident">
        <dc:Bounds x="1140" y="70" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_UpdateDashboard" bpmnElement="Task_UpdateDashboard">
        <dc:Bounds x="1140" y="210" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_1" bpmnElement="EndEvent_1">
        <dc:Bounds x="1370" y="232" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="156" y="178" />
        <di:waypoint x="210" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="360" y="178" />
        <di:waypoint x="390" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2b" bpmnElement="Flow_2b">
        <di:waypoint x="610" y="178" />
        <di:waypoint x="640" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_3" bpmnElement="Flow_3">
        <di:waypoint x="790" y="178" />
        <di:waypoint x="840" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4" bpmnElement="Flow_4">
        <di:waypoint x="990" y="178" />
        <di:waypoint x="1040" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="1090" y="178" />
        <di:waypoint x="1225" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="1090" y="178" />
        <di:waypoint x="1225" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="1225" y="150" />
        <di:waypoint x="1225" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="1310" y="250" />
        <di:waypoint x="1370" y="250" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
